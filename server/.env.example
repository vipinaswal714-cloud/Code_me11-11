# ====================================================================
# Metrica Backend Proxy Server Configuration (Server-Side Only)
# Copy this file to server/.env and configure your Google Gemini key.
# NEVER commit server/.env to version control.
# ====================================================================

# Port for the Metrica AI Backend Proxy Server
PORT=3001

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
# The server will refuse to start if this key is missing.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model Name (restricted to allowed models)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Trust reverse proxy X-Forwarded-For headers (only enable if behind Nginx/Cloudflare)
TRUST_PROXY=false

# Allowed CORS Origins (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Daily Request & Token Quota Limits per IP
DAILY_MAX_REQUESTS=500
DAILY_MAX_TOKENS=100000

# Supabase Server Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
