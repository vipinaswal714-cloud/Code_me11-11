# ====================================================================
# Metrica Frontend Environment Configuration Example
# Copy this file to .env.local for local frontend development.
# NEVER put secret keys, database passwords, or Gemini keys in this file.
# The Gemini API key belongs strictly in server/.env
# ====================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (sb_publishable_... or public anon key)
# NEVER put SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_key

# Backend Proxy Server Port (used by dev proxy)
PORT=3001

# Allowed CORS Origins (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
