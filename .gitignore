# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build and dependencies
node_modules/
dist/
dist-ssr/
coverage/
*.local

# Environment files (anywhere in the project)
.env
.env.*
**/.env
**/.env.*
.env.local
.env.*.local
.envrc
.dev.vars
.dev.vars.*
server/.env
server/.env.*
# Explicit exceptions to keep example templates tracked (placed after override patterns)
!.env.example
!**/.env.example
!server/.env.example

# Supabase local files (migrations and config.toml remain tracked)
supabase/.temp/
supabase/.branches/
supabase/**/.env*

